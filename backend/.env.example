MONGODB_URI=mongodb://localhost:27017/jobshield_ai
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
AI_SERVICE_URL=http://127.0.0.1:8001
PORT=4000
FRONTEND_URL=http://localhost:3000

# Set to true to enable the Python transformer models (requires ai-service to be running)
# Set to false to use the fast, local rule engine and heuristics (default)
USE_REAL_AI=false

# ---------------------------------------------------------
# Security & Threat Intelligence API Keys
# ---------------------------------------------------------
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
WHOIS_API_KEY=your_whois_xml_api_key_here

# ---------------------------------------------------------
# AI & LLM Provider API Keys (RAG Reasoning Waterfall)
# ---------------------------------------------------------
# Primary: NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here

# Secondary: Groq (Fast Alternative)
GROQ_API_KEY=your_groq_api_key_here

# Tertiary: OpenRouter (free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backup: Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here

NVIDIA_MODEL=meta/llama3-70b-instruct
OPENROUTER_MODEL=openrouter/auto
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b

# Abstracted Provider: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
