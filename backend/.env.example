# ============================================================
# JobShield AI — Environment Variables Example
# Copy this to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/jobshield_ai

# ---- Security (REQUIRED in production — server will refuse to start without these) ----
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
SESSION_SECRET=replace-with-a-different-long-random-secret

# ---- CORS ----
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- AI Service (Python RAG service) ----
AI_SERVICE_URL=http://127.0.0.1:8001

# ---- Agent Mode: "live" | "degraded" ----
AGENT_MODE=live

# ---- Gemini (Primary LLM) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_SECONDARY_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-1.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_MS=4000

# ---- LLM Waterfall Provider Config ----
LLM_PROVIDER=google
LLM_FALLBACK_PROVIDERS=groq,cerebras

# ---- Multi-Provider API Keys (optional — for LLM waterfall) ----
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ---- Multi-Provider Models (optional) ----
GROQ_MODEL=llama3-70b-8192
OPENROUTER_MODEL=openrouter/auto
CEREBRAS_MODEL=llama3-70b
NVIDIA_MODEL=meta/llama3-70b-instruct

# ---- Threat Intelligence API Keys (optional) ----
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
WHOIS_API_KEY=your_whois_xml_api_key_here
